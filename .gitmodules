[submodule "lib/@openzeppelin-contracts"]
	path = lib/@openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
	branch = master
[submodule "lib/@openzeppelin-contracts-upgradeable"]
	path = lib/@openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
	branch = master
[submodule "lib/forge-std"]
	path = lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "lib/@openzeppelin-community-contracts"]
	path = lib/@openzeppelin-community-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-community-contracts
	branch = master
[submodule "lib/zk-email-verify"]
	path = lib/zk-email-verify
	url = https://github.com/zkemail/zk-email-verify
[submodule "lib/email-tx-builder"]
	path = lib/email-tx-builder
	url = https://github.com/zkemail/email-tx-builder
