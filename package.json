{
  "name": "openzeppelin-accounts",
  "private": true,
  "description": "Standardized modular tooling and SDK for EVM smart accounts",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format:write": "prettier --write '**/*.{js,ts,sol}'",
    "format:check": "prettier --check '**/*.{js,ts,sol}'",
    "sync-artifact": "node scripts/sync-artifact.mjs",
    "postinstall": "node scripts/sync-artifact.mjs"
  },
  "keywords": [
    "solidity",
    "smart-accounts",
    "EVM",
    "ethereum",
    "ERC-4337",
    "ERC-7579"
  ],
  "author": "OpenZeppelin Accounts Contributors",
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@openzeppelin-accounts/contracts": "link:packages/contracts",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.6",
    "get-port": "^7.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-solidity": "^2.1.0",
    "typescript-eslint": "^8.72.0"
  }
}
