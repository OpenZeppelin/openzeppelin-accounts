{
  "name": "@openzeppelin-accounts/contracts",
  "version": "0.0.1",
  "description": "Standardized modular tooling and SDK for EVM smart accounts",
  "author": "OpenZeppelin Accounts Contributors",
  "license": "MIT",
  "files": [
    "/src/**/*.sol",
    "!/src/mocks/**/*",
    "/build/contracts/*.json",
    "README.md"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean && rimraf build contracts/build",
    "prepack": "bash scripts/prepack.sh",
    "coverage": "scripts/checks/coverage.sh",
    "test": "pnpm run test:regular && pnpm run test:fhe",
    "test:regular": "hardhat test",
    "test:fhe": "FHE=true hardhat test"
  },
  "keywords": [
    "solidity",
    "smart-accounts",
    "EVM",
    "ethereum",
    "ERC-4337",
    "ERC-7579"
  ],
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@fhevm/solidity": "0.11.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@openzeppelin/contracts": "file:../../lib/@openzeppelin-contracts",
    "@openzeppelin/contracts-upgradeable": "file:../../lib/@openzeppelin-contracts-upgradeable",
    "@zama-fhe/oracle-solidity": "^0.2.0",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "encrypted-types": "^0.0.4",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.0",
    "hardhat-exposed": "^0.3.19",
    "hardhat-predeploy": "^0.4.1",
    "micromatch": "^4.0.8",
    "rimraf": "^6.0.1",
    "solidity-coverage": "^0.8.16"
  }
}
