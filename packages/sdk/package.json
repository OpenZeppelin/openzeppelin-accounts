{
  "name": "@openzeppelin-accounts/sdk",
  "version": "0.0.1",
  "description": "SDK for OpenZeppelin Accounts",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-artifact.mjs && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "compile": "tsc",
    "compile:watch": "tsc -w",
    "test": "ava",
    "test:watch": "ava -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenZeppelin/openzeppelin-accounts.git"
  },
  "author": "OpenZeppelin Accounts Contributors",
  "license": "MIT",
  "dependencies": {
    "viem": "^2.44.4"
  },
  "devDependencies": {
    "@ava/typescript": "^5.0.0",
    "@fast-check/ava": "^2.0.2",
    "@noble/curves": "^2.4.0",
    "@pimlico/alto": "^0.0.20",
    "@types/node": "^25.9.9",
    "ava": "^6.4.1",
    "fast-check": "^4.10.2",
    "hardhat-predeploy": "^0.4.1",
    "ox": "^0.12.4",
    "prettier": "^3.5.3",
    "prool": "^0.2.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ethereum",
    "smart-contracts",
    "evm",
    "smart-accounts"
  ]
}
